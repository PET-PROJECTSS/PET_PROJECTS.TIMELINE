# Окружение: dev | prod
# В prod обязательны TIMELINE_ADMIN_PASSWORD и TIMELINE_OBSERVER_PASSWORD,
# иначе приложение упадёт с RuntimeError (пароли нельзя генерировать молча).
ENV=dev

# База данных. По умолчанию — SQLite (файл roadmaps.db в корне проекта).
# Для PostgreSQL в docker-compose этот параметр задаётся автоматически.
# DATABASE_URL=postgresql+psycopg://timeline:password@localhost:5432/timeline

# Параметры PostgreSQL-сервиса (используются docker-compose.yml)
POSTGRES_USER=timeline
POSTGRES_PASSWORD=
POSTGRES_DB=timeline

# Логин и пароль администратора (роль: admin, полный доступ)
TIMELINE_ADMIN_USER=admin
TIMELINE_ADMIN_PASSWORD=

# Логин и пароль наблюдателя (роль: observer, только просмотр)
TIMELINE_OBSERVER_USER=observer
TIMELINE_OBSERVER_PASSWORD=

# TTL сессии в секундах (по умолчанию 30 суток)
# TIMELINE_SESSION_TTL_SECONDS=2592000

# Лимит попыток входа и время блокировки (сек)
# TIMELINE_LOGIN_MAX_ATTEMPTS=5
# TIMELINE_LOGIN_LOCKOUT_SECONDS=30

# Ресайз воркеров gunicorn (защита от утечек памяти)
# GUNICORN_WORKERS=3
# GUNICORN_MAX_REQUESTS=1000
# GUNICORN_MAX_REQUESTS_JITTER=100

# Максимальный размер тела запроса в байтах (2 МБ)
# TIMELINE_MAX_PAYLOAD_BYTES=2097152

# Домен, на котором приложение доступно снаружи (для Caddy/TLS).
# Для локальной проверки подойдёт localhost, для реального деплоя — боевой домен.
DOMAIN=localhost

# Список IP, которым доверяются заголовки X-Forwarded-For от Caddy.
# За прокси обязательно должно быть «*», иначе rate-limit логина видит IP прокси.
# FORWARDED_ALLOW_IPS=*
